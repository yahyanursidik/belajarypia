VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_AUTH_REDIRECT_ORIGIN=https://hub.ihsanuladab.or.id

# Cloudflare Turnstile public site key for learner self-registration.
# Enable CAPTCHA in Supabase Auth only after this key is configured.
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Supabase Auth emails are configured in Supabase Dashboard, not in the frontend.
# Dashboard > Authentication > SMTP Settings:
# Sender email / SMTP user: ahlan@yahyanursidik.my.id
# SMTP host: mx.kerjamail.co
# SMTP port: 587 (STARTTLS) or 465 (SSL fallback)
# SMTP password must stay only in Supabase Dashboard.

# Supabase Edge Function secrets for private Contabo S3-compatible storage.
# Set with: supabase secrets set S3_ENDPOINT=... S3_BUCKET=... etc.
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=us-east-1
S3_BUCKET=ypia-lms-private
S3_ACCESS_KEY_ID=your-contabo-access-key
S3_SECRET_ACCESS_KEY=your-contabo-secret-key
S3_SIGNED_URL_EXPIRES_SECONDS=900
